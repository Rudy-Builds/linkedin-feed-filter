{
  "manifest_version": 3,
  "name": "LinkedIn Feed Filter",
  "version": "1.0.0",
  "description": "Calm your LinkedIn feed: tuck videos and pictures behind a button, hide promoted and suggested posts, and cap how many posts you see.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["defaults.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn Feed Filter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
